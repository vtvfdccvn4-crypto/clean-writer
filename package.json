{
  "name": "clear-writer-app",
  "private": true,
  "version": "0.1.0-rc.1",
  "description": "Clear Writer is a focused document editor and PDF exporter.",
  "author": "Clear Writer Contributors",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.web.config.ts",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "tsc && vite build --config vite.web.config.ts",
    "build:web": "tsc && vite build --config vite.web.config.ts",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:styles": "node scripts/check-style-contract.mjs",
    "check:computed-styles": "node scripts/check-computed-styles.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.cjs",
    "test:perf": "node --test --test-concurrency=1 test/*.perf.cjs",
    "test:browser-smoke": "node scripts/release-browser-smoke.mjs",
    "diagnose:browser-runtime": "node scripts/diagnose-browser-runtime.mjs",
    "test:pwa-smoke": "npm run build && node scripts/release-web-shell-smoke.mjs",
    "release:prep": "npm run typecheck && npm run check:styles && npm run build && npm run check:bundle && npm run test:pagedjs-patch && npm test && npm run test:perf && npm run test:pdf-scale && npm run test:browser-smoke && npm run test:pwa-smoke",
    "profile:preview": "node --expose-gc scripts/profile-preview.mjs",
    "profile:pagination": "node scripts/profile-pagination.mjs",
    "profile:preview-baseline": "node scripts/profile-pagination.mjs --scale --output reports/preview-baseline.json",
    "test:pdf-scale": "node scripts/profile-pagination.mjs --scale",
    "preview": "vite preview --outDir dist-web",
    "postinstall": "patch-package",
    "test:pagedjs-patch": "node scripts/verify-pagedjs-patch.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "patch-package": "^8.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/google-sans-code": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "material-symbols": "^0.45.10",
    "pagedjs": "0.4.3",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}
