{
  "name": "@clear-writer/codebase-pdf-preview",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Isolated browser pipeline for compiling source text into immutable paginated PDF-preview artifacts.",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./frame": "./src/frame-entry.ts"
  },
  "peerDependencies": {
    "pagedjs": "0.4.3"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:browser": "node scripts/browser-smoke.mjs"
  }
}
